# Browser Research Agent Configuration

# Agent Mode: SUBSCRIPTION or API
# - SUBSCRIPTION: Use Claude Code/Max subscription (default, no API key needed)
# - API: Use Anthropic API with pay-per-token billing
BRA_AGENT_MODE=SUBSCRIPTION

# Only needed for API mode:
# BRA_ANTHROPIC_API_KEY=sk-ant-xxxxx
# BRA_MODEL=claude-sonnet-4-20250514

# Proxy settings
BRA_PROXY_HOST=127.0.0.1
BRA_PROXY_PORT=8080

# Browser settings
BRA_BROWSER_TYPE=chromium
BRA_HEADLESS=false

# Storage
BRA_DATA_DIR=./data
BRA_DB_PATH=./data/research.db

# CDP
BRA_CDP_PORT=9222
